# Optional: enable the LLM second pass (default is False so tests run offline)
LLM_MODEL=anthropic/claude-haiku-4-5
API_KEY=sk-...

# Required for hash/surrogate redaction strategies
PHI_HASH_KEY=change-me-to-a-long-random-secret

# Optional: regions for phone number parsing (defaults to NZ,AU)
PHI_REGIONS=NZ,AU
